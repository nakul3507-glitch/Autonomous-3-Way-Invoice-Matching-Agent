        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "D0BR8K33JKG",
          "mode": "id"
        },
        "text": "=⚠️ Flagged for Human Review!\n• Vendor: {{ $('JSON').item.json.output[0].content[0].text.vendor_name }}\n• Invoice Number: {{ $('JSON').item.json.output[0].content[0].text.invoice_number }}\n• PO Number: {{ $('po').item.json[\"PO Number\"] }}\n• GR Number: {{ $('GR').item.json[\"GR Number\"] }}\n• Status: Failed\n• Discrepancy Reason: {{\n  (() => {\n    const cleanNum = (v) => Number(String(v).replace(/[^0-9.]/g, \"\"));\n    const fmt = (n) => n.toLocaleString(\"en-IN\");\n\n    const raw = $('JSON').item.json.output[0].content[0].text;\n    const ai = (typeof raw === \"string\") ? JSON.parse(raw) : raw;\n\n    const poAmt  = cleanNum($('po').item.json[\"Approved Amount\"]);\n    const ordQty = cleanNum($('po').item.json[\"Ordered Qty\"]);\n    const grQty  = cleanNum($('GR').item.json[\"Received Qty\"]);\n    const insp   = String($('GR').item.json[\"Inspection Status\"] || \"\").trim().toLowerCase();\n\n    const invAmt = cleanNum(ai.total_amount);\n    const invQty = cleanNum(ai.quantity);\n\n    const reasons = [];\n    if (poAmt !== invAmt)  reasons.push(\"PO Approved Amount (\" + fmt(poAmt) + \") does not match Invoice Total Amount (\" + fmt(invAmt) + \")\");\n    if (grQty !== invQty)  reasons.push(\"GR Received Quantity (\" + fmt(grQty) + \") does not match Invoice Quantity (\" + fmt(invQty) + \")\");\n    if (ordQty !== invQty) reasons.push(\"PO Ordered Quantity (\" + fmt(ordQty) + \") does not match Invoice Quantity (\" + fmt(invQty) + \")\");\n    if (insp !== \"passed\") reasons.push(\"Inspection Status is '\" + insp.toUpperCase() + \"' (not Passed)\");\n\n    return reasons.length\n      ? reasons.join(\" AND \") + \".\"\n      : \"Discrepancy detected during 3-way matching (check vendor / invoice details).\";\n  })()\n}}",
        "otherOptions": {}
      },
